# macOS configuration
ifeq ($(UNAME), Darwin)
  # Detect Homebrew prefix
  HOMEBREW_PREFIX := $(shell brew --prefix 2>/dev/null)
  ifeq ($(HOMEBREW_PREFIX),)
    ifneq ($(wildcard /opt/homebrew/bin/brew),)
      HOMEBREW_PREFIX := /opt/homebrew
    else
      HOMEBREW_PREFIX := /usr/local
    endif
  endif

  # Override FLIBS only if Homebrew gfortran is available
  GFORTRAN_LIB := $(HOMEBREW_PREFIX)/lib/gcc/current
  ifneq ($(wildcard $(GFORTRAN_LIB)/libgfortran*),)
    FLIBS = -L$(GFORTRAN_LIB) -lgfortran -lquadmath
  endif

  ARCH := $(shell uname -m)
  ifeq ($(ARCH),x86_64)
    ifdef MKLROOT
      # Intel macOS with MKL: use MKL (includes Intel OpenMP via -liomp5)
      PKG_CPPFLAGS += -DUSEMKL -I$(MKLROOT)/include
      PKG_LIBS += -L$(MKLROOT)/lib -lmkl_rt -liomp5 -lpthread -lm
      $(info MKL detected on Intel macOS, enabling Pardiso.)
    endif
  endif

  # OpenMP on macOS: link Homebrew libomp by full path (if installed).
  # Uses full path to avoid picking up R's potentially outdated bundled libomp.
  # If libomp is not installed, OpenMP is silently disabled (#pragma omp ignored).
  ifndef NGME_SKIP_LIBOMP_LINK
    LIBOMP_DYLIB := $(HOMEBREW_PREFIX)/opt/libomp/lib/libomp.dylib
    ifneq ($(wildcard $(LIBOMP_DYLIB)),)
      ifeq ($(SHLIB_OPENMP_CXXFLAGS),)
        PKG_CXXFLAGS += -Xclang -fopenmp
      endif
      # Apple clang does not ship omp.h; it comes from the Homebrew libomp keg.
      PKG_CPPFLAGS += -I$(HOMEBREW_PREFIX)/opt/libomp/include
      PKG_LIBS += $(LIBOMP_DYLIB)
    endif
  endif
endif

# Enable MKL/Pardiso when MKLROOT is provided (e.g., oneAPI) on non-macOS
ifneq ($(UNAME), Darwin)
  ifdef MKLROOT
    PKG_CPPFLAGS += -DUSEMKL -I$(MKLROOT)/include
    PKG_LIBS += -L$(MKLROOT)/lib/intel64 \
               -lmkl_rt -lmkl_gnu_thread -lmkl_core \
               -lgomp -lpthread -lm -ldl
    $(info MKL detected, enabling Pardiso.)
  endif
endif

